func TestUtilEntriesGetSize(t *testing.T) {
	h := createHarForUtil()

	size := h.Log.Entries[0].GetSize()
	// Request header size 150 + request body size 0 + response header size 120 + response body size 1024 = 1294
	// (note: AddEntry sets HeadersSize=-1 and BodySize=-1 by default, but
	//  SetResponseContent only sets Content fields, not BodySize/HeadersSize)
	// The actual values depend on how the test HAR was constructed.
	// Since AddEntry sets -1 for sizes, and nothing overrides them here,
	// GetSize treats -1 as 0.
	if size < 0 {
		t.Errorf("GetSize() = %d, should not be negative", size)
	}

	// nil receiver
	var nilEntry *Entries
	if nilEntry.GetSize() != 0 {
		t.Error("GetSize() on nil Entries should return 0")
	}
}

func TestUtilEntriesToCurl(t *testing.T) {
	h := createHarForUtil()

	curl := h.Log.Entries[0].ToCurl()
	if curl == "" {
		t.Fatal("ToCurl() returned an empty string")
	}
	if !strings.Contains(curl, "curl") {
		t.Error("ToCurl() should contain 'curl'")
	}
	// GET requests should not include the -X option.
	if strings.Contains(curl, "-X GET") {
		t.Error("ToCurl() for a GET request should not contain '-X GET'")
	}
	// Should include request headers
	if !strings.Contains(curl, "-H") {
		t.Error("ToCurl() should contain the -H option")
	}
	// Should include URL
	if !strings.Contains(curl, "https://example.com/api/users") {
		t.Error("ToCurl() should contain the request URL")
	}

	// POST requests should include -X POST and --data.
	postCurl := h.Log.Entries[1].ToCurl()
	if !strings.Contains(postCurl, "-X POST") {
		t.Error("ToCurl() for a POST request should contain '-X POST'")
	}
	if !strings.Contains(postCurl, "--data") {
		t.Error("ToCurl() for a POST request should contain '--data'")
	}

	// nil receiver
	var nilEntry *Entries
	if nilEntry.ToCurl() != "" {
		t.Error("ToCurl() on nil Entries should return an empty string")
	}
}

func TestUtilEntriesToWget(t *testing.T) {
	h := createHarForUtil()

	wget := h.Log.Entries[0].ToWget()
	if wget == "" {
		t.Fatal("ToWget() returned an empty string")
	}
	if !strings.Contains(wget, "wget") {
		t.Error("ToWget() should contain 'wget'")
	}
	if !strings.Contains(wget, "--header") {
		t.Error("ToWget() should contain '--header'")
	}
	if !strings.Contains(wget, "https://example.com/api/users") {
		t.Error("ToWget() should contain the request URL")
	}

	// POST request
	postWget := h.Log.Entries[1].ToWget()
	if !strings.Contains(postWget, "--method=POST") {
		t.Error("ToWget() for a POST request should contain '--method=POST'")
	}
	if !strings.Contains(postWget, "--post-data") && !strings.Contains(postWget, "--body-data") {
		t.Error("ToWget() for a POST request should contain '--post-data' or '--body-data'")
	}

	// nil receiver
	var nilEntry *Entries
	if nilEntry.ToWget() != "" {
		t.Error("ToWget() on nil Entries should return an empty string")
	}
}

