func TestUtilContentEncodeDecodeRoundTrip(t *testing.T) {
	c := &Content{}
	originalData := []byte{0x00, 0x01, 0x02, 0xFF, 0xFE, 0xFD}
	c.EncodeContent(originalData, "application/octet-stream")

	// Simulate JSON deserialization
	data, err := json.Marshal(c)
	if err != nil {
		t.Fatalf("Failed to serialize Content: %v", err)
	}

	var decoded Content
	if err := json.Unmarshal(data, &decoded); err != nil {
		t.Fatalf("Failed to deserialize Content: %v", err)
	}

	// Verify decoding using GetResponseBody
	entry := &Entries{}
	entry.Response.Content = decoded
	entry.Response.Status = 200

	body, err := entry.GetResponseBody()
	if err != nil {
		t.Fatalf("GetResponseBody() returned error: %v", err)
	}
	if !bytes.Equal(body, originalData) {
		t.Errorf("Encoding/decoding round trip failed: got %v, want %v", body, originalData)
	}
}

func TestUtilGetUniqueDomainsWithParsedHar(t *testing.T) {
	h, err := ParseHarFile("testdata/full.har")
	if err != nil {
		t.Fatalf("Failed to parse full.har: %v", err)
	}

	domains := h.GetUniqueDomains()
	if len(domains) == 0 {
		t.Error("full.har should have at least one domain")
	}

	// Verify that domains are sorted.
	for i := 1; i < len(domains); i++ {
		if domains[i] < domains[i-1] {
			t.Errorf("Domains are not sorted: %q appears before %q.", domains[i], domains[i-1])
		}
	}
}

