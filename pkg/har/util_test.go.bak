// ========== Helper functions ==========

// createHarForUtil creates a HAR object for testing utility methods
func createHarForUtil() *Har {
	h := NewHar()
	h.SetCreator("test-util", "1.0")
	h.SetBrowser("TestBrowser", "1.0")

	e1 := h.AddEntry("GET", "https://example.com/api/users?id=1&format=json", "HTTP/1.1", "page_1")
	e1.SetResponseStatus(200, "OK")
	e1.SetResponseContent(1024, "application/json")
	e1.SetResponseContentText(`{"users":[]}`)
	e1.AddRequestHeader("Accept", "application/json")
	e1.AddRequestHeader("User-Agent", "Go-HAR Test")
	e1.AddResponseHeader("Content-Type", "application/json")
	e1.AddResponseHeader("Cache-Control", "no-cache")
	e1.AddCookie("session", "abc123")
	e1.AddResponseCookie("tracking", "xyz789")
	e1.ServerIPAddress = "192.168.1.1"
	e1.Connection = "conn1"
	e1.SetTimings(10, 5, 15, 3, 50, 10, 8)

	e2 := h.AddEntry("POST", "https://other.com/api/data", "HTTP/1.1", "")
	e2.SetResponseStatus(404, "Not Found")
	e2.SetResponseContent(512, "text/html")
	e2.SetPostData("application/json", `{"key":"value"}`)
	e2.AddRequestHeader("Content-Type", "application/json")
	e2.AddResponseHeader("X-Error", "true")
	e2.SetTimings(5, 2, 8, 2, 30, 5, 3)

	e3 := h.AddEntry("GET", "https://cdn.example.com/static/style.css", "HTTP/1.1", "")
	e3.SetResponseStatus(301, "Moved Permanently")
	e3.SetResponseContent(128, "text/css")
	e3.AddResponseHeader("Location", "https://cdn2.example.com/style.css")
	e3.SetTimings(1, 1, 2, 1, 10, 2, 1)

	e4 := h.AddEntry("GET", "https://example.com/api/error", "HTTP/1.1", "")
	e4.SetResponseStatus(500, "Internal Server Error")
	e4.SetResponseContent(64, "application/json")
	e4.SetTimings(2, 1, 3, 1, 20, 3, 2)

	return h
}

// ========== Har method tests ==========

func TestUtilHarClone(t *testing.T) {
	h := createHarForUtil()
	clone := h.Clone()

	if clone == nil {
		t.Fatal("Clone() returned nil")
	}

	// Verify that the clone has the same contents as the original.
	if clone.Log.Version != h.Log.Version {
		t.Errorf("Clone() version mismatch: got %q, want %q", clone.Log.Version, h.Log.Version)
	}
	if clone.Log.Creator.Name != h.Log.Creator.Name {
		t.Errorf("Clone() creator name mismatch: got %q, want %q", clone.Log.Creator.Name, h.Log.Creator.Name)
	}
	if len(clone.Log.Entries) != len(h.Log.Entries) {
		t.Errorf("Clone() entry count mismatch: got %d, want %d", len(clone.Log.Entries), len(h.Log.Entries))
	}

	// Verify deep copy: modifying the clone should not affect the original.
	clone.Log.Entries[0].Request.Method = "PUT"
	if h.Log.Entries[0].Request.Method == "PUT" {
		t.Error("Clone() is not a deep copy; modifying the clone affected the original")
	}

	clone.Log.Entries[0].Request.Headers[0].Value = "modified"
	if h.Log.Entries[0].Request.Headers[0].Value == "modified" {
		t.Error("Clone() header slice was not deeply copied; modifying the clone affected the original")
	}
}

func TestUtilHarCloneNil(t *testing.T) {
	var h *Har = nil
	clone := h.Clone()
	if clone != nil {
		t.Error("Clone() on a nil Har should return nil")
	}
}

func TestUtilHarGetEntryCount(t *testing.T) {
	h := createHarForUtil()

	count := h.GetEntryCount()
	if count != 4 {
		t.Errorf("GetEntryCount() = %d, want 4", count)
	}

	// Empty HAR
	emptyHar := NewHar()
	if emptyHar.GetEntryCount() != 0 {
		t.Errorf("GetEntryCount() of an empty HAR = %d, want 0", emptyHar.GetEntryCount())
	}

	// nil receiver
	var nilHar *Har
	if nilHar.GetEntryCount() != 0 {
		t.Errorf("GetEntryCount() on a nil Har = %d, want 0", nilHar.GetEntryCount())
	}
}

func TestUtilHarWalk(t *testing.T) {
	h := createHarForUtil()

	// Test normal iteration
	var visited []string
	err := h.Walk(func(e *Entries) error {
		visited = append(visited, e.Request.Method)
		return nil
	})
	if err != nil {
		t.Errorf("Walk() returned error: %v", err)
	}
	if len(visited) != 4 {
		t.Errorf("Walk() visited %d entries, want 4", len(visited))
	}

	// Test early termination
	var earlyVisited []string
	err = h.Walk(func(e *Entries) error {
		earlyVisited = append(earlyVisited, e.Request.Method)
		if len(earlyVisited) == 2 {
			return io.EOF
		}
		return nil
	})
	if err != io.EOF {
		t.Errorf("Walk() error on early termination = %v, want io.EOF", err)
	}
	if len(earlyVisited) != 2 {
		t.Errorf("Walk() visited on early termination %d entries, want 2", len(earlyVisited))
	}

	// nil receiver
	var nilHar *Har
	err = nilHar.Walk(func(e *Entries) error { return nil })
	if err != nil {
		t.Errorf("Walk() on a nil Har should not return an error, got %v", err)
	}
}

func TestUtilHarGetUniqueDomains(t *testing.T) {
	h := createHarForUtil()

	domains := h.GetUniqueDomains()
	expected := []string{"cdn.example.com", "example.com", "other.com"}
	if len(domains) != len(expected) {
		t.Errorf("GetUniqueDomains() returned %d domains, want %d", len(domains), len(expected))
	}
	for i, d := range domains {
		if d != expected[i] {
			t.Errorf("GetUniqueDomains()[%d] = %q, want %q", i, d, expected[i])
		}
	}

	// nil receiver
	var nilHar *Har
	if nilHar.GetUniqueDomains() != nil {
		t.Error("GetUniqueDomains() on a nil Har should return nil")
	}
}

func TestUtilHarEquals(t *testing.T) {
	h1 := createHarForUtil()
	h2 := createHarForUtil()

	// Same contents
	if !h1.Equals(h2) {
		t.Error("Equals() should return true for HARs with identical contents")
	}

	// Modify version
	h2.Log.Version = "1.1"
	if h1.Equals(h2) {
		t.Error("Equals() should return false for different versions")
	}
	h2.Log.Version = h1.Log.Version

	// Modify creator
	h2.Log.Creator.Name = "different"
	if h1.Equals(h2) {
		t.Error("Equals() should return false for different creators")
	}
	h2.Log.Creator.Name = h1.Log.Creator.Name

	// Modify browser
	h2.Log.Browser.Name = "OtherBrowser"
	if h1.Equals(h2) {
		t.Error("Equals() should return false for different browsers")
	}
	h2.Log.Browser.Name = h1.Log.Browser.Name

	// Modify entry count
	h2.Log.Entries = h2.Log.Entries[:3]
	if h1.Equals(h2) {
		t.Error("Equals() should return false for different entry counts")
	}

	// Modify entry method
	h2 = createHarForUtil()
	h2.Log.Entries[0].Request.Method = "PUT"
	if h1.Equals(h2) {
		t.Error("Equals() should return false for different entry methods")
	}

	// Modify entry URL
	h2 = createHarForUtil()
	h2.Log.Entries[0].Request.URL = "https://different.com"
	if h1.Equals(h2) {
		t.Error("Equals() should return false for different entry URLs")
	}

	// Modify entry status code
	h2 = createHarForUtil()
	h2.Log.Entries[0].Response.Status = 404
	if h1.Equals(h2) {
		t.Error("Equals() should return false for different status codes")
	}

	// Both nil
	var nilH1, nilH2 *Har
	if !nilH1.Equals(nilH2) {
		t.Error("Equals() should return true when both are nil")
	}

	// One side nil
	if nilH1.Equals(h1) {
		t.Error("Equals() should return false when one side is nil")
	}
	if h1.Equals(nilH1) {
		t.Error("Equals() should return false when one side is nil")
	}
}

func TestUtilHarSaveToFileGzipped(t *testing.T) {
	h := createHarForUtil()

	// Create a temporary file
	tmpFile, err := os.CreateTemp("", "har_test_*.har.gz")
	if err != nil {
		t.Fatalf("failed to create temporary file: %v", err)
	}
	tmpPath := tmpFile.Name()
	tmpFile.Close()
	defer os.Remove(tmpPath)

	// Save as a gzip-compressed file
	err = h.SaveToFileGzipped(tmpPath, true)
	if err != nil {
		t.Fatalf("SaveToFileGzipped() returned error: %v", err)
	}

	// Verify the file is a valid gzip file.
	f, err := os.Open(tmpPath)
	if err != nil {
		t.Fatalf("failed to open gzip file: %v", err)
	}
	defer f.Close()

	gzReader, err := gzip.NewReader(f)
	if err != nil {
		t.Fatalf("failed to create gzip reader: %v", err)
	}
	defer gzReader.Close()

	data, err := io.ReadAll(gzReader)
	if err != nil {
		t.Fatalf("failed to read gzip data: %v", err)
	}

	// Verify the decompressed content is valid HAR JSON.
	var parsedHar Har
	if err := json.Unmarshal(data, &parsedHar); err != nil {
		t.Fatalf("failed to parse decompressed JSON: %v", err)
	}
	if parsedHar.GetEntryCount() != 4 {
		t.Errorf("Decompressed HAR entry count = %d, want 4", parsedHar.GetEntryCount())
	}

	// nil receiver
	var nilHar *Har
	err = nilHar.SaveToFileGzipped(tmpPath, true)
	if err == nil {
		t.Error("SaveToFileGzipped() on a nil Har should return an error")
	}
}

func TestUtilHarSaveToWriter(t *testing.T) {
	h := createHarForUtil()

	var buf bytes.Buffer
	err := h.SaveToWriter(&buf, false)
	if err != nil {
		t.Fatalf("SaveToWriter() returned error: %v", err)
	}

	// Verify that valid JSON was written.
	var parsedHar Har
	if err := json.Unmarshal(buf.Bytes(), &parsedHar); err != nil {
		t.Fatalf("failed to parse SaveToWriter output: %v", err)
	}
	if parsedHar.GetEntryCount() != 4 {
		t.Errorf("HAR entry count in SaveToWriter output = %d, want 4", parsedHar.GetEntryCount())
	}

	// Test with indentation
	buf.Reset()
	err = h.SaveToWriter(&buf, true)
	if err != nil {
		t.Fatalf("SaveToWriter(indent=true) returned error: %v", err)
	}
	if !strings.Contains(buf.String(), "\n") {
		t.Error("SaveToWriter(indent=true) output should contain a newline")
	}

	// nil receiver
	var nilHar *Har
	err = nilHar.SaveToWriter(&buf, true)
	if err == nil {
		t.Error("SaveToWriter() on a nil Har should return an error")
	}
}

// ========== Entries method tests ==========

func TestUtilEntriesIsError(t *testing.T) {
	h := createHarForUtil()

	tests := []struct {
		entryIdx int
		want     bool
	}{
		{0, false}, // 200
		{1, true},  // 404
		{2, false}, // 301
		{3, true},  // 500
	}
	for _, tt := range tests {
		got := h.Log.Entries[tt.entryIdx].IsError()
		if got != tt.want {
			t.Errorf("Entries[%d].IsError() = %v, want %v", tt.entryIdx, got, tt.want)
		}
	}

	// nil receiver
	var nilEntry *Entries
	if nilEntry.IsError() != false {
		t.Error("IsError() on nil Entries should return false")
	}
}

