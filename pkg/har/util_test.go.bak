// ========== Content method tests ==========

func TestUtilContentEncodeContent(t *testing.T) {
	c := &Content{}
	data := []byte("hello world binary data")
	c.EncodeContent(data, "application/octet-stream")

	if c.Encoding != "base64" {
		t.Errorf("EncodeContent() set Encoding = %q, want %q", c.Encoding, "base64")
	}
	if c.MimeType != "application/octet-stream" {
		t.Errorf("EncodeContent() set MimeType = %q, want %q", c.MimeType, "application/octet-stream")
	}
	if c.Size != len(data) {
		t.Errorf("EncodeContent() set Size = %d, want %d", c.Size, len(data))
	}

	// Verify that Text is decoded correctly.
	decoded, err := base64.StdEncoding.DecodeString(c.Text)
	if err != nil {
		t.Fatalf("Base64 decoding failed: %v", err)
	}
	if string(decoded) != string(data) {
		t.Errorf("Decoded data = %q, want %q", string(decoded), string(data))
	}

	// nil receiver
	var nilContent *Content
	nilContent.EncodeContent(data, "text/plain") // should not panic
}

func TestUtilContentSetText(t *testing.T) {
	c := &Content{}
	text := "Hello, World!"
	c.SetText(text)

	if c.Text != text {
		t.Errorf("SetText() set Text = %q, want %q", c.Text, text)
	}
	if c.Size != len(text) {
		t.Errorf("SetText() set Size = %d, want %d", c.Size, len(text))
	}

	// Update text
	newText := "Updated text"
	c.SetText(newText)
	if c.Text != newText {
		t.Errorf("SetText() updated Text = %q, want %q", c.Text, newText)
	}
	if c.Size != len(newText) {
		t.Errorf("SetText() updated Size = %d, want %d", c.Size, len(newText))
	}

	// nil receiver
	var nilContent *Content
	nilContent.SetText("test") // should not panic
}

// ========== Tests parsing from test files ==========

func TestUtilParseAndUseMethods(t *testing.T) {
	// Parse HAR from a test file
	h, err := ParseHarFile("testdata/full.har")
	if err != nil {
		t.Fatalf("Failed to parse test file: %v", err)
	}

	// Test various utility methods
	if h.GetEntryCount() < 1 {
		t.Error("HAR parsed from file should have at least one entry")
	}

	domains := h.GetUniqueDomains()
	if len(domains) == 0 {
		t.Error("GetUniqueDomains() should return at least one domain")
	}

	// Test the first entry method
	entry := &h.Log.Entries[0]
	if !entry.IsSuccess() {
		t.Error("The first entry should be a successful response (200)")
	}

	u := entry.GetURL()
	if u == nil {
		t.Fatal("GetURL() returned nil")
	}

	domain := entry.GetDomain()
	if domain == "" {
		t.Error("GetDomain() should not return an empty string")
	}

	// Test request methods
	reqHeader := entry.Request.GetHeader("Accept")
	if reqHeader == "" {
		t.Error("GetHeader(\"Accept\") should not be empty")
	}

	// Test response methods
	respCT := entry.Response.GetContentType()
	if respCT == "" {
		t.Error("GetContentType() should not be empty")
	}
}

